{
  "routes": [
    {
      "route": "/api/scheduling/availability",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/api/cancellations",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/api/documentation-compliance",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/api/mileage",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/ms-redirect.html",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/signed-out.html",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad?prompt=select_account"
    }
  }
}
